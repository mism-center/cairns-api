# Copy to .env and adjust. docker-compose and the scripts read these.

# ── Model backend ─────────────────────────────────────────────────────────────
# ollama = fully local (needs GPU for speed).  openai = cloud API (no GPU needed).
MODEL_BACKEND=ollama

# -- if MODEL_BACKEND=ollama --
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# -- if MODEL_BACKEND=openai (or any OpenAI-compatible endpoint) --
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Vector store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=tooldb_tools
TOOLDB_QDRANT_COLLECTION=tooldb_tools

# ── Knowledge graph (SQLite) ──────────────────────────────────────────────────
KG_BACKEND=sqlite
KG_SQLITE_PATH=/data/tooldb_kg.sqlite

# ── Index build inputs ────────────────────────────────────────────────────────
# Path to the ToolDB catalog JSON (mount it into the container at this path).
TOOLDB_JSON_PATH=/data/tooldb.json
TOOLDB_LIMIT=300            # subset of ToolDB for fast first build; 0 = all
BIOMODELS_LIMIT=200        # how many BioModels to fetch (only used if FETCH_BIOMODELS=true)
BIOMODELS_QUERY=*          # BioModels search query; * = everything
FETCH_BIOMODELS=false      # true = re-fetch from biomodels.org over the network
MISM_LIMIT=1000            # how many MISM models to fetch (only used if FETCH_MISM=true)
MISM_BASE_URL=https://mism-dev.renci.org/api/v1
FETCH_MISM=false           # true = re-fetch from the MISM API over the network

# build_indexes.sh is static by default: once data/tools_combined.json exists
# it's reused as-is (no network calls) on every build. Set this to true to
# force a re-merge from the per-source files above (combined with
# FETCH_BIOMODELS/FETCH_MISM=true to also refresh those sources first).
FORCE_REBUILD_SOURCES=false

# ── Misc ──────────────────────────────────────────────────────────────────────
LANGFUSE_ENABLED=false
INPUT_GUARD_ENABLED=false
API_PORT=8000
